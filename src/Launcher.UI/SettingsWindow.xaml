<Window x:Class="Launcher.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Launcher.UI.Converters"
        Title="设置"
        Height="470" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="White" FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif"
        FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <conv:HotkeyTextConverter x:Key="HotkeyTextConv"/>
        <conv:PathToImageConverter x:Key="PathToImageConv"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConv"/>
        <conv:EnumToBoolConverter x:Key="EnumToBoolConv"/>
    </Window.Resources>

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置" FontSize="18" FontWeight="SemiBold" Foreground="#1F1F1F"/>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 通用 -->
                <TextBlock Text="通用" FontWeight="SemiBold" Foreground="#3B6BB5" Margin="0,0,0,8"/>
                <DockPanel Margin="0,4">
                    <TextBlock Text="开机自动启动" VerticalAlignment="Center"/>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding RunAtStartup}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="通过注册表 Run 键实现，无需管理员权限" Foreground="#999" FontSize="11" Margin="0,2,0,4"/>
                <DockPanel Margin="0,10,0,4">
                    <TextBlock Text="显示 Dock 栏" VerticalAlignment="Center"/>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowDock}" VerticalAlignment="Center"/>
                </DockPanel>

                <Rectangle Height="1" Fill="#ECECEC" Margin="0,12,0,12"/>

                <!-- Dock 外观 -->
                <TextBlock Text="Dock 外观" FontWeight="SemiBold" Foreground="#3B6BB5" Margin="0,0,0,8"/>
                <DockPanel Margin="0,4" LastChildFill="True">
                    <TextBlock Text="图标尺寸" VerticalAlignment="Center" Width="70"/>
                    <TextBlock Text="{Binding DockIconSize, StringFormat={}{0:0}}" VerticalAlignment="Center"
                               Width="36" TextAlignment="Right" Foreground="#666"/>
                    <Slider Minimum="24" Maximum="56" TickFrequency="2" IsSnapToTickEnabled="True"
                            Value="{Binding DockIconSize}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>

                <TextBlock Text="中心按钮图标" Margin="0,12,0,4"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="选择图标…" Width="92" Height="30" Click="OnPickIcon"/>
                    <Button Content="恢复默认" Width="84" Height="30" Margin="10,0,0,0" Click="OnResetIcon"/>
                    <Border Width="34" Height="34" Margin="16,0,0,0" CornerRadius="17"
                            Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="1" VerticalAlignment="Center">
                        <Image Width="30" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding DockCenterIconPath, Converter={StaticResource PathToImageConv}}"/>
                    </Border>
                    <TextBlock Text="预览" Foreground="#999" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <Rectangle Height="1" Fill="#ECECEC" Margin="0,12,0,12"/>

                <!-- 面板 -->
                <TextBlock Text="面板" FontWeight="SemiBold" Foreground="#3B6BB5" Margin="0,0,0,8"/>
                <DockPanel Margin="0,4">
                    <TextBlock Text="弹出位置" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="左下角" Margin="0,0,14,0"
                                     IsChecked="{Binding PanelPosition, Converter={StaticResource EnumToBoolConv}, ConverterParameter=BottomLeft}"/>
                        <RadioButton Content="居中"
                                     IsChecked="{Binding PanelPosition, Converter={StaticResource EnumToBoolConv}, ConverterParameter=Center}"/>
                    </StackPanel>
                </DockPanel>

                <!-- 全局热键 -->
                <TextBlock Text="全局热键" FontWeight="SemiBold" Foreground="#3B6BB5" Margin="0,0,0,8"/>
                <DockPanel Margin="0,4">
                    <TextBlock Text="启用全局热键" VerticalAlignment="Center"/>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding HotkeyEnabled}" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,8,0,4" LastChildFill="True">
                    <TextBlock Text="当前快捷键" VerticalAlignment="Center" Width="70"/>
                    <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#666">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource HotkeyTextConv}">
                                <Binding Path="HotkeyModifiers"/>
                                <Binding Path="HotkeyKey"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Button x:Name="RecordBtn" Content="录制热键…" Width="100" Height="30"
                            DockPanel.Dock="Right" Click="OnRecordHotkey"/>
                </DockPanel>
                <TextBlock x:Name="HotkeyHint" Text="默认 Ctrl+Alt+Space。启用后即使本程序未激活，按下快捷键也会弹出搜索面板。"
                           Foreground="#999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="关于" Width="80" Height="32" Click="OnAbout"/>
            <Button Content="关闭" Width="80" Height="32" HorizontalAlignment="Right"
                    DockPanel.Dock="Right" Click="OnClose"/>
        </DockPanel>
    </Grid>
</Window>
