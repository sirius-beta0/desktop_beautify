<Window x:Class="Launcher.UI.IconCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="裁剪中心按钮图标" Height="520" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow" Topmost="True"
        Background="White" FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif"
        FontSize="13"
        Loaded="Window_Loaded">

    <Window.Resources>
        <RectangleGeometry x:Key="SquareClip" Rect="0,0,300,300"/>
    </Window.Resources>

    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="裁剪中心按钮图标" FontSize="18" FontWeight="SemiBold" Foreground="#1F1F1F"/>
        <TextBlock Grid.Row="1" Text="拖拽移动、滑动缩放，确认后生成正方形图标。"
                   Foreground="#999" FontSize="11" Margin="0,4,0,14"/>

        <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="1" Background="White"
                Width="302" Height="302" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas x:Name="CropCanvas" Width="300" Height="300"
                    Clip="{StaticResource SquareClip}"
                    Background="Transparent"
                    MouseLeftButtonDown="OnCanvasMouseDown"
                    MouseMove="OnCanvasMouseMove"
                    MouseLeftButtonUp="OnCanvasMouseUp"
                    MouseLeave="OnCanvasMouseLeave">
                <Image x:Name="SourceImage" Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ScaleTf" ScaleX="1" ScaleY="1" CenterX="0" CenterY="0"/>
                            <TranslateTransform x:Name="TranslateTf" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Canvas>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="缩放" VerticalAlignment="Center" Grid.Column="0"/>
            <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="0.2" Maximum="3.0" Value="1.0"
                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                    VerticalAlignment="Center" Margin="10,0"
                    ValueChanged="OnZoomChanged"/>
            <Button Content="适应" Width="60" Height="26" Grid.Column="2" Click="OnFit"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Height="32" Click="OnCancel" IsCancel="True"/>
            <Button Content="确定" Width="80" Height="32" Margin="10,0,0,0" Click="OnConfirm" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
