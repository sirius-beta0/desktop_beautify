<Window x:Class="Launcher.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Launcher.Core;assembly=Launcher.Core"
        xmlns:local="clr-namespace:Launcher.UI"
        Title="关于 DesktopBeautify Launcher"
        Height="480" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Topmost="True"
        MinHeight="360" MinWidth="420"
        Background="White" FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif"
        FontSize="13">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Launcher.UI;component/Assets/logo.png"
                   Width="40" Height="40" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="DesktopBeautify Launcher" FontSize="20" FontWeight="SemiBold"
                       Foreground="#1F1F1F" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,8,0,0" Foreground="#666">
            <Run Text="版本 v"/><Run Text="{x:Static core:AppInfo.Version}"/>
        </TextBlock>

        <Rectangle Grid.Row="2" Height="1" Fill="#E2E2E2" Margin="0,16,0,0"/>

        <!-- 信息区（可滚动，避免内容被截断） -->
        <ScrollViewer Grid.Row="3" Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <DockPanel Margin="0,6">
                    <TextBlock Text="作者" Width="80" Foreground="#888"/>
                    <TextBlock Text="{x:Static core:AppInfo.Author}" Foreground="#1F1F1F"/>
                </DockPanel>
                <DockPanel Margin="0,6">
                    <TextBlock Text="开源协议" Width="80" Foreground="#888"/>
                    <TextBlock Text="{x:Static core:AppInfo.LicenseFullName}" Foreground="#1F1F1F"/>
                </DockPanel>
                <DockPanel Margin="0,6">
                    <TextBlock Text="项目地址" Width="80" Foreground="#888"/>
                    <TextBlock>
                        <Hyperlink x:Name="GitHubLink"
                                   RequestNavigate="OnGitHubNavigate"
                                   ToolTip="{x:Static core:AppInfo.GitHubUrl}">
                            <Run Text="{x:Static core:AppInfo.GitHubUrl}"/>
                        </Hyperlink>
                    </TextBlock>
                </DockPanel>
                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#666" LineHeight="20">
                    一款 Windows 桌面美化 / 效率工具：常驻 Dock 栏 + 可固定到任务栏的轻量应用启动器。
                    基于 .NET 8 与 WPF 构建，以 Apache-2.0 协议开源。
                </TextBlock>

                <Rectangle Height="1" Fill="#E2E2E2" Margin="0,18,0,0"/>

                <!-- 第三方开源组件 -->
                <TextBlock Text="第三方开源组件" FontWeight="SemiBold" Foreground="#1F1F1F" Margin="0,14,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="#999" Margin="0,0,0,8">
                    本项目在构建 / 发布时引用了以下开源组件（均为 MIT 许可证）：
                </TextBlock>
                <ItemsControl ItemsSource="{x:Static local:AboutWindow.ThirdParty}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,5">
                                <TextBlock Foreground="#1F1F1F">
                                    <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <Run Text="  v"/><Run Text="{Binding Version}"/>
                                    <Run Text="  ·  "/><Run Text="{Binding License}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Copyright}" Foreground="#999" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#666">
                    完整许可证文本与版权声明见
                    <Hyperlink x:Name="NoticesLink" RequestNavigate="OnOpenNotices">THIRD-PARTY-NOTICES.md</Hyperlink>
                    （随程序分发，或访问项目仓库）。
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- 关闭 -->
        <Button Grid.Row="4" Content="关闭" Width="90" Height="32" HorizontalAlignment="Right"
                Margin="0,12,0,0" Click="OnClose"/>
    </Grid>
</Window>
