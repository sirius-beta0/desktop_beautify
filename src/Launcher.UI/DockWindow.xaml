<Window x:Class="Launcher.UI.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Launcher.Core.Indexing;assembly=Launcher.Core"
        xmlns:conv="clr-namespace:Launcher.UI.Converters"
        xmlns:local="clr-namespace:Launcher.UI"
        Title="DesktopBeautify Dock"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif"
        PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
        Loaded="OnLoaded">

    <Window.Resources>
        <conv:FirstCharConverter x:Key="FirstCharConv"/>
        <conv:PathToImageConverter x:Key="PathToImageConv"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConv"/>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConv"/>

        <!-- 单个收藏图标：尺寸绑定 AppSettings.DockIconSize；内部 32×32 设计经 Viewbox 等比缩放
             （白色圆底 / 圆形裁剪 / 首字母占位统一随动），悬浮由代码放大到 1.5× -->
        <DataTemplate x:Key="DockIconTemplate" DataType="{x:Type core:AppEntry}">
            <Grid Width="{Binding DockIconSize, Source={StaticResource AppSettings}}"
                  Height="{Binding DockIconSize, Source={StaticResource AppSettings}}"
                  Margin="5,6" Cursor="Hand" Tag="DockIcon"
                  Background="Transparent"
                  RenderTransformOrigin="0.5,0.5"
                  MouseLeftButtonUp="OnDockAppLaunch">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <!-- 悬浮放大：用 IsMouseOver 属性触发器（纯 WPF 属性系统），
                     不依赖 DataTemplate 内路由事件处理器的解析，规避 MouseEnter 静默失效。 -->
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.5" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.5" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Viewbox Stretch="Uniform">
                    <Grid Width="32" Height="32">
                        <!-- 白色圆形底衬：保证所有图标（含透明/方形图标）视觉上都是统一的圆形白底 -->
                        <Ellipse Width="32" Height="32" Fill="White" IsHitTestVisible="False"/>
                        <Image Width="32" Height="32" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Loaded="OnDockIconLoaded"
                               IsHitTestVisible="False">
                            <Image.Clip>
                                <EllipseGeometry Center="16,16" RadiusX="15.5" RadiusY="15.5"/>
                            </Image.Clip>
                        </Image>
                        <!-- 图标未加载（异步/失败）时显示首字母占位；加载成功后由代码隐藏 -->
                        <Border x:Name="DockPh" IsHitTestVisible="False" Visibility="Collapsed">
                            <TextBlock Text="{Binding Name, Converter={StaticResource FirstCharConv}}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="#3B6BB5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <!-- 添加收藏占位：透明 + 号，无白色底衬，悬浮放大与图标一致；点击打开搜索面板 -->
        <DataTemplate x:Key="DockAddTemplate" DataType="{x:Type core:AppEntry}">
            <Grid Width="{Binding DockIconSize, Source={StaticResource AppSettings}}"
                  Height="{Binding DockIconSize, Source={StaticResource AppSettings}}"
                  Margin="5,6" Cursor="Hand" Tag="DockAdd"
                  Background="Transparent"
                  RenderTransformOrigin="0.5,0.5"
                  MouseLeftButtonUp="OnDockAppLaunch">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.5" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.5" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Viewbox Stretch="Uniform">
                    <TextBlock Text="+" FontSize="26" FontWeight="Light" Foreground="#9AA0A6"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <local:DockTemplateSelector x:Key="DockTemplateSelector"/>
    </Window.Resources>

    <!-- 长条背景：半透明圆角卡片。注意：透明窗体(AllowsTransparency)上挂 DropShadowEffect
         会在子元素做 RenderTransform 缩放动画时偶发让渲染线程抛 NullReferenceException 而崩溃，
         故此处不用 Effect，改用底色+描边模拟悬浮感（更稳）。 -->
    <Border x:Name="Bar" CornerRadius="18" Background="#F4F4F4F4"
            BorderBrush="#CFCFCF" BorderThickness="1" Padding="8,6">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 中心按钮左侧：奇数索引，FlowDirection=RTL 使 fav[1] 紧贴中心按钮 -->
            <ItemsControl ItemsSource="{Binding DockLeft}" ItemTemplateSelector="{StaticResource DockTemplateSelector}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- 中心呼出按钮：点击切换应用搜索面板（从 Dock 上方弹出） -->
            <Button x:Name="CenterButton" Width="34" Height="34" Margin="6,0" Cursor="Hand"
                    PreviewMouseUp="OnCenterButtonUp">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <!-- 悬浮放大：与 Dock 图标完全一致的 IsMouseOver 属性触发器（纯 WPF 属性系统） -->
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.5" Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.5" Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Ellipse Fill="#3B6BB5" Stroke="#FFFFFF" StrokeThickness="1.5"/>
                            <!-- 中心按钮自定义图标：设置 DockCenterIconPath 后显示，隐藏默认 X -->
                            <Image Source="{Binding DockCenterIconPath, Source={StaticResource AppSettings}, Converter={StaticResource PathToImageConv}}"
                                   Width="22" Height="22" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding DockCenterIconPath, Source={StaticResource AppSettings}, Converter={StaticResource NullToVisibilityConv}}"/>
                            <!-- 默认 X 图标：无自定义图标时显示 -->
                            <Path Data="M5,5 L11,11 M11,5 L5,11" Stroke="White" StrokeThickness="2"
                                  StrokeEndLineCap="Round" Width="16" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{Binding DockCenterIconPath, Source={StaticResource AppSettings}, Converter={StaticResource NotNullToVisibilityConv}}"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 中心按钮右侧：偶数索引，LTR 使 fav[0] 紧贴中心按钮，越靠前越靠近中心 -->
            <ItemsControl ItemsSource="{Binding DockRight}" ItemTemplateSelector="{StaticResource DockTemplateSelector}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
