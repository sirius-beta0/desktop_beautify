<Window x:Class="Launcher.UI.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Launcher.Core.Indexing;assembly=Launcher.Core"
        xmlns:local="clr-namespace:Launcher.UI"
        xmlns:conv="clr-namespace:Launcher.UI.Converters"
        Width="640" Height="480"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif">

    <Window.Resources>
        <conv:FirstCharConverter x:Key="FirstCharConverter"/>
        <DataTemplate x:Key="AppItemTemplate" DataType="{x:Type core:AppEntry}">
            <StackPanel Width="84" Margin="4" Cursor="Hand"
                        MouseLeftButtonUp="OnAppLaunch">
                <Border Width="48" Height="48" CornerRadius="10"
                        Background="#D7E3F4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Name, Converter={StaticResource FirstCharConverter}}"
                               FontSize="20" FontWeight="SemiBold" Foreground="#3B6BB5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Name}"
                           Margin="0,6,0,0" FontSize="11" Foreground="#333"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           HorizontalAlignment="Center" MaxWidth="80"
                           ToolTip="{Binding Name}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>


    <Border x:Name="Shell"
            Margin="8" CornerRadius="12"
            Background="#F2F2F2F2" BorderBrush="#E0E0E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.18" Color="Black"/>
        </Border.Effect>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="8" Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="12,8">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             BorderThickness="0" Background="Transparent"
                             FontSize="14" Foreground="#202020"
                             CaretBrush="#202020"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="OnSearchStateChanged"
                             GotFocus="OnSearchStateChanged"
                             LostFocus="OnSearchStateChanged"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="搜索应用…"
                               Foreground="#888" FontSize="14"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="1,0,0,0"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,12,0,0"
                  x:Name="ContentHost">
                <TextBlock x:Name="EmptyHint"
                           Text="正在索引已安装应用…"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#888" FontSize="13"/>
                <ItemsControl x:Name="AppGrid"
                              ItemsSource="{Binding AppsView}"
                              ItemTemplate="{StaticResource AppItemTemplate}"
                              Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</Window>