<Window x:Class="Launcher.UI.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Launcher.Core.Indexing;assembly=Launcher.Core"
        xmlns:local="clr-namespace:Launcher.UI"
        xmlns:conv="clr-namespace:Launcher.UI.Converters"
        Width="572" Height="560"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif">

    <Window.Resources>
        <conv:FirstCharConverter x:Key="FirstCharConverter"/>
        <DataTemplate x:Key="AppItemTemplate" DataType="{x:Type core:AppEntry}">
            <!-- 方型磁贴卡片：图标完全居中，名称置于底部，悬浮整卡加深 -->
            <Grid Width="128" Height="128" Margin="0" Cursor="Hand"
                  MouseLeftButtonUp="OnAppLaunch">
                <!-- 图标在卡片内上下左右完全居中 -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      Width="48" Height="48">
                    <!-- 占位：图标未加载（异步/失败）时显示首字母；透明底，加载成功后由代码隐藏 -->
                    <Border Tag="Placeholder">
                        <TextBlock Text="{Binding Name, Converter={StaticResource FirstCharConverter}}"
                                   FontSize="28" FontWeight="SemiBold" Foreground="#3B6BB5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- 真图标：透明 PNG，叠在占位之上 -->
                    <Image x:Name="IconImg" Stretch="Uniform"
                           Width="48" Height="48"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Loaded="OnTileLoaded"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <!-- 名称置于卡片底部 -->
                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           Margin="0,0,0,12" FontSize="11" Foreground="#333"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           MaxWidth="120" ToolTip="{Binding Name}"/>
                <!-- 悬浮加深层：覆盖整张卡片（方型无圆角），hover 时整卡加深 -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1A000000"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>


    <Border x:Name="Shell"
            Margin="8" CornerRadius="12"
            Background="#F2F2F2F2" BorderBrush="#E0E0E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.18" Color="Black"/>
        </Border.Effect>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="8" Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="12,8">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             BorderThickness="0" Background="Transparent"
                             FontSize="14" Foreground="#202020"
                             CaretBrush="#202020"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="OnSearchStateChanged"
                             GotFocus="OnSearchStateChanged"
                             LostFocus="OnSearchStateChanged"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="搜索应用…"
                               Foreground="#888" FontSize="14"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="1,0,0,0"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,12,0,0"
                  x:Name="ContentHost">
                <TextBlock x:Name="EmptyHint"
                           Text="正在索引已安装应用…"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#888" FontSize="13"/>
                <ItemsControl x:Name="AppGrid"
                              ItemsSource="{Binding AppsView}"
                              ItemTemplate="{StaticResource AppItemTemplate}"
                              Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</Window>