<Window x:Class="Launcher.UI.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="480"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif">

    <Border x:Name="Shell"
            Margin="8" CornerRadius="12"
            Background="#F2F2F2F2" BorderBrush="#E0E0E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.18" Color="Black"/>
        </Border.Effect>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="8" Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="12,8">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             BorderThickness="0" Background="Transparent"
                             FontSize="14" Foreground="#202020"
                             CaretBrush="#202020"
                             TextChanged="OnSearchStateChanged"
                             GotFocus="OnSearchStateChanged"
                             LostFocus="OnSearchStateChanged"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="搜索应用…"
                               Foreground="#888" FontSize="14"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="1,0,0,0"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,12,0,0"
                  x:Name="ContentHost">
                <TextBlock x:Name="EmptyHint"
                           Text="尚未索引应用（下一里程碑将填充收藏与搜索结果）"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#888" FontSize="13"/>
                <ItemsControl x:Name="AppGrid" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>